# Telegram Bot Configuration
TELEGRAM_TOKEN=your_telegram_bot_token_here
# Опционально: username бота без @ (для кнопок «Открыть бота», если get_me недоступен)
# TELEGRAM_BOT_USERNAME=my_bot_name
GROQ_API_KEY=your_groq_api_key_here
HUGGING_FACE_TOKEN=your_huggingface_token_here

# Course Scheduler Configuration
BOT_TOKEN=your_telegram_bot_token_here
CHAT_ID=your_group_chat_id_here
PERIOD_DAYS=4
TZ=Europe/Minsk
COURSE_SCHEDULER_ENABLED=1
STATE_FILE=state.json

# Пауза между успешными выдачами урока в ЛС (сек., по умолчанию 20). Только после удачи — не мешает открыть бота и повторить.
# LESSON_COOLDOWN_SECONDS=20

# Напоминания неактивным ученикам
# Через сколько дней без урока слать напоминание (0 = отключить напоминания)
REMINDER_INACTIVE_DAYS=3
# Час дня (по TZ) когда слать напоминания (0-23), по умолчанию 10:00
REMINDER_HOUR=10

# Optional Configuration
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-20b
HUGGING_FACE_API_URL=https://api-inference.huggingface.co/models/microsoft/DialoGPT-large
TYPING_DELAY=1.5
MAX_MESSAGE_LENGTH=4000
MAX_CONTEXT_MESSAGES=10
USER_DB_FILE=users.json
# GOOGLE_SHEETS_CREDENTIALS=
# GOOGLE_SHEETS_SPREADSHEET=
# GOOGLE_SHEETS_WORKSHEET=Users

# Creator Information
CREATOR_USERNAME=@vadzim_belarus
TELEGRAM_CHANNEL=https://t.me/vadzimby_live
WEBSITE_URL=https://vadzim.by/

# Admin Access (optional)
# Use the numeric Telegram user ID of the primary admin. This enables admin commands even if the username is missing.
CREATOR_USER_ID=
# Provide additional admin user IDs separated by commas or spaces, e.g. "123 456".
ADMIN_USER_IDS=
